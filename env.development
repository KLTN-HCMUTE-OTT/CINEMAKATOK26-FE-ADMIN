# Development Environment Configuration
NODE_ENV=development

# Application Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="OTT Admin Dashboard (Dev)"
NEXT_PUBLIC_APP_VERSION=1.0.0-dev

# Security Settings (Development - Use weak secrets for local development)
CSRF_SECRET=dev-csrf-secret-change-in-production
SESSION_SECRET=dev-session-secret-change-in-production
JWT_SECRET=dev-jwt-secret-change-in-production

# Database Configuration (Local development)
REDIS_URL=redis://localhost:6379/0

# External APIs (Development/Mock endpoints)
NEXT_PUBLIC_CDN_URL=http://localhost:3000/mock-cdn
STORAGE_BUCKET_NAME=ott-dev-bucket
STORAGE_ACCESS_KEY=dev-access-key
STORAGE_SECRET_KEY=dev-secret-key

# Monitoring & Analytics (Disabled in development)
SENTRY_DSN=
NEXT_PUBLIC_ANALYTICS_ID=

# Email Service (Use test/mock service)
EMAIL_SERVICE_API_KEY=dev-email-key
EMAIL_FROM_ADDRESS=dev@localhost

# Rate Limiting (Relaxed for development)
RATE_LIMIT_MAX_REQUESTS=1000
RATE_LIMIT_WINDOW_MS=60000

# Security Headers (Relaxed for development)
NEXT_PUBLIC_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Development Settings
LOG_LEVEL=debug
ENABLE_PERFORMANCE_MONITORING=true
ENABLE_MOCK_DATA=true
ENABLE_DEBUG_TOOLS=true
