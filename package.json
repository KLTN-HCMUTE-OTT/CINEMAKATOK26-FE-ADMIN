{
  "name": "next-app-test",
  "version": "0.1.0",
  "license": "Commercial",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3022",
    "build": "next build",
    "start": "next start -p 3022",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx}\"",
    "build:icons": "tsx src/assets/iconify-icons/bundle-icons-css.ts",
    "postinstall": "npm run build:icons",
    "analyze": "ANALYZE=true npm run build",
    "build:production": "NODE_ENV=production npm run build",
    "test:performance": "npm run build && npm run start",
    "check:bundle": "npm run analyze",
    "api:gen": "api2ts",
    "test": "cross-env NODE_OPTIONS=--max-old-space-size=4096 vitest",
    "test:run": "cross-env NODE_OPTIONS=--max-old-space-size=4096 vitest run",
    "test:coverage": "cross-env NODE_OPTIONS=--max-old-space-size=4096 vitest run --coverage",
    "test:ui": "cross-env NODE_OPTIONS=--max-old-space-size=4096 vitest --ui --open false",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:install": "playwright install --with-deps chromium firefox",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
