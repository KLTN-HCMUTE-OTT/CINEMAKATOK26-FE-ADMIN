# Production Environment Configuration
NODE_ENV=production

# Application Settings
NEXT_PUBLIC_APP_URL=https://ott-admin.yourcompany.com
NEXT_PUBLIC_APP_NAME="OTT Admin Dashboard"
NEXT_PUBLIC_APP_VERSION=1.0.0

# Security Settings (CRITICAL: Use strong, unique secrets)
CSRF_SECRET=REPLACE_WITH_PRODUCTION_CSRF_SECRET_64_CHARS_MIN
SESSION_SECRET=REPLACE_WITH_PRODUCTION_SESSION_SECRET_64_CHARS_MIN
JWT_SECRET=REPLACE_WITH_PRODUCTION_JWT_SECRET_64_CHARS_MIN


# External APIs (Production endpoints)
NEXT_PUBLIC_CDN_URL=https://cdn.yourott.com
STORAGE_BUCKET_NAME=ott-production-content
STORAGE_ACCESS_KEY=REPLACE_WITH_PRODUCTION_STORAGE_ACCESS_KEY
STORAGE_SECRET_KEY=REPLACE_WITH_PRODUCTION_STORAGE_SECRET_KEY

# Monitoring & Analytics (Production monitoring)
SENTRY_DSN=REPLACE_WITH_PRODUCTION_SENTRY_DSN
NEXT_PUBLIC_ANALYTICS_ID=REPLACE_WITH_PRODUCTION_ANALYTICS_ID


# Rate Limiting (Strict production limits)
RATE_LIMIT_MAX_REQUESTS=50
RATE_LIMIT_WINDOW_MS=900000

# Security Headers (Production domains only)
NEXT_PUBLIC_ALLOWED_ORIGINS=https://ott-admin.yourcompany.com,https://yourott.com

# Production Settings
LOG_LEVEL=error
ENABLE_PERFORMANCE_MONITORING=true
ENABLE_MOCK_DATA=false
ENABLE_DEBUG_TOOLS=false

# Additional Production Settings
ENABLE_HTTPS_REDIRECT=true
ENABLE_SECURITY_HEADERS=true
ENABLE_RATE_LIMITING=true
ENABLE_ERROR_REPORTING=true
