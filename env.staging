# Staging Environment Configuration
NODE_ENV=staging

# Application Settings
NEXT_PUBLIC_APP_URL=https://ott-admin-staging.vercel.app
NEXT_PUBLIC_APP_NAME="OTT Admin Dashboard (Staging)"
NEXT_PUBLIC_APP_VERSION=1.0.0-staging

# Security Settings (Use proper secrets in staging)
CSRF_SECRET=REPLACE_WITH_STAGING_CSRF_SECRET
SESSION_SECRET=REPLACE_WITH_STAGING_SESSION_SECRET
JWT_SECRET=REPLACE_WITH_STAGING_JWT_SECRET


# External APIs (Staging endpoints)
NEXT_PUBLIC_CDN_URL=https://staging-cdn.example.com
STORAGE_BUCKET_NAME=ott-staging-bucket
STORAGE_ACCESS_KEY=REPLACE_WITH_STAGING_STORAGE_ACCESS_KEY
STORAGE_SECRET_KEY=REPLACE_WITH_STAGING_STORAGE_SECRET_KEY

# Monitoring & Analytics (Staging environment)
SENTRY_DSN=REPLACE_WITH_STAGING_SENTRY_DSN
NEXT_PUBLIC_ANALYTICS_ID=REPLACE_WITH_STAGING_ANALYTICS_ID

# Email Service (Staging email service)
EMAIL_SERVICE_API_KEY=REPLACE_WITH_STAGING_EMAIL_API_KEY
EMAIL_FROM_ADDRESS=staging@yourott.com

# Rate Limiting (Production-like limits)
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

# Security Headers (Staging domains)
NEXT_PUBLIC_ALLOWED_ORIGINS=https://ott-admin-staging.vercel.app

# Staging Settings
LOG_LEVEL=info
ENABLE_PERFORMANCE_MONITORING=true
ENABLE_MOCK_DATA=false
ENABLE_DEBUG_TOOLS=false
